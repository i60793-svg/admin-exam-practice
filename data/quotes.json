[
  {
    "zh": "能帶給你內心平靜的，只有你自己。",
    "en": "Nothing can bring you peace but yourself.",
    "author": "愛默生",
    "work": "《自立》",
    "source": "https://www.gutenberg.org/cache/epub/16643/pg16643-images.html"
  },
  {
    "zh": "學而時習之，不亦說乎？",
    "author": "孔子",
    "work": "《論語・學而》",
    "source": "https://ctext.org/analects/xue-er/zh"
  },
  {
    "zh": "堅持做自己，別一味模仿他人。",
    "en": "Insist on yourself; never imitate.",
    "author": "愛默生",
    "work": "《自立》",
    "source": "https://www.gutenberg.org/cache/epub/16643/pg16643-images.html"
  },
  {
    "zh": "溫故而知新，可以為師矣。",
    "author": "孔子",
    "work": "《論語・為政》",
    "source": "https://tct.gov.taipei/News_Content.aspx?n=F1FEADA96EEB06A9&s=BB684B0293DBF4F0"
  },
  {
    "zh": "簡化，再簡化。",
    "en": "Simplify, simplify.",
    "author": "梭羅",
    "work": "《湖濱散記》",
    "source": "https://www.gutenberg.org/files/205/205-h/205-h.htm"
  },
  {
    "zh": "學而不思則罔，思而不學則殆。",
    "author": "孔子",
    "work": "《論語・為政》",
    "source": "https://tct.gov.taipei/News_Content.aspx?n=F1FEADA96EEB06A9&s=BB684B0293DBF4F0"
  },
  {
    "zh": "最重要的是，忠於你自己。",
    "en": "This above all: to thine own self be true;",
    "author": "莎士比亞",
    "work": "《哈姆雷特》",
    "source": "https://www.gutenberg.org/files/1524/1524-h/1524-h.htm"
  },
  {
    "zh": "知之為知之，不知為不知，是知也。",
    "author": "孔子",
    "work": "《論語・為政》",
    "source": "https://tct.gov.taipei/News_Content.aspx?n=F1FEADA96EEB06A9&s=BB684B0293DBF4F0"
  },
  {
    "zh": "棲守道德者，寂寞一時；依附權勢者，淒涼萬古。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "道千乘之國，敬事而信，節用而愛人，使民以時。",
    "author": "孔子",
    "work": "《論語》",
    "source": "https://zh.wikisource.org/zh-hant/論語/全覽",
    "excerpt": true
  },
  {
    "zh": "有無相生，難易相成，長短相形，高下相盈，音聲相和，前後相隨。",
    "author": "老子",
    "work": "《道德經》",
    "source": "https://zh.wikisource.org/zh-hant/老子_(匯校版)",
    "excerpt": true
  },
  {
    "zh": "涉世淺，點染亦淺；歷事深，機械亦深。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "弟子入則孝，出則弟，謹而信，汎愛眾，而親仁。",
    "author": "孔子",
    "work": "《論語》",
    "source": "https://zh.wikisource.org/zh-hant/論語/全覽",
    "excerpt": true
  },
  {
    "zh": "是以聖人處無為之事，行不言之教；萬物作而弗始，生而弗有，為而弗恃，功成而不居。",
    "author": "老子",
    "work": "《道德經》",
    "source": "https://zh.wikisource.org/zh-hant/老子_(匯校版)",
    "excerpt": true
  },
  {
    "zh": "君子之心事，天青日白，不可使人不知。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "君子不重則不威，學則不固。",
    "author": "孔子",
    "work": "《論語》",
    "source": "https://zh.wikisource.org/zh-hant/論語/全覽",
    "excerpt": true
  },
  {
    "zh": "挫其銳，解其紛，和其光，同其塵。",
    "author": "老子",
    "work": "《道德經》",
    "source": "https://zh.wikisource.org/zh-hant/老子_(匯校版)",
    "excerpt": true
  },
  {
    "zh": "勢利紛華，不近者為潔，近之而不染者為尤潔；智械機巧，不知者為高，知之而不用者為尤高。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "君子食無求飽，居無求安，敏於事而愼於言，就有道而正焉：可謂好學也已。",
    "author": "孔子",
    "work": "《論語》",
    "source": "https://zh.wikisource.org/zh-hant/論語/全覽",
    "excerpt": true
  },
  {
    "zh": "虛而不屈，動而愈出。",
    "author": "老子",
    "work": "《道德經》",
    "source": "https://zh.wikisource.org/zh-hant/老子_(匯校版)",
    "excerpt": true
  },
  {
    "zh": "耳中常聞逆耳之言，心中常有拂心之事，纔是進德修行的砥石。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "不患人之不己知，患不知人也。",
    "author": "孔子",
    "work": "《論語》",
    "source": "https://zh.wikisource.org/zh-hant/論語/全覽",
    "excerpt": true
  },
  {
    "zh": "多聞數窮，不如守中。",
    "author": "老子",
    "work": "《道德經》",
    "source": "https://zh.wikisource.org/zh-hant/老子_(匯校版)",
    "excerpt": true
  },
  {
    "zh": "疾風怒雨，禽鳥戚戚；霽日光風，草木欣欣。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "為政以德，譬如北辰，居其所，而眾星共之。",
    "author": "孔子",
    "work": "《論語》",
    "source": "https://zh.wikisource.org/zh-hant/論語/全覽",
    "excerpt": true
  },
  {
    "zh": "天地所以能長且久者，以其不自生，故能長生。",
    "author": "老子",
    "work": "《道德經》",
    "source": "https://zh.wikisource.org/zh-hant/老子_(匯校版)",
    "excerpt": true
  },
  {
    "zh": "醲肥辛甘非真味，真味只是淡；神奇卓異非至人，至人只是常。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "詩三百，一言以蔽之，曰思無邪。",
    "author": "孔子",
    "work": "《論語》",
    "source": "https://zh.wikisource.org/zh-hant/論語/全覽",
    "excerpt": true
  },
  {
    "zh": "是以聖人後其身而身先，外其身而身存。",
    "author": "老子",
    "work": "《道德經》",
    "source": "https://zh.wikisource.org/zh-hant/老子_(匯校版)",
    "excerpt": true
  },
  {
    "zh": "天地寂然不動，而氣機無一息少停；日月晝夜奔馳，而貞明則萬古不易。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "道之以政，齊之以刑，民免而無恥；道之以德，齊之以禮，有恥且格。",
    "author": "孔子",
    "work": "《論語》",
    "source": "https://zh.wikisource.org/zh-hant/論語/全覽",
    "excerpt": true
  },
  {
    "zh": "上善若水，水善利萬物而不爭。",
    "author": "老子",
    "work": "《道德經》",
    "source": "https://zh.wikisource.org/zh-hant/老子_(匯校版)",
    "excerpt": true
  },
  {
    "zh": "夜深人靜，獨坐觀心，始覺妄窮而真獨露，每於此中得大機趣；既覺真現而妄難逃，又於此中得大慚忸。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "吾十有五而志於學；三十而立；四十而不惑；五十而知天命；六十而耳順；七十而從心所欲，不踰矩。",
    "author": "孔子",
    "work": "《論語》",
    "source": "https://zh.wikisource.org/zh-hant/論語/全覽",
    "excerpt": true
  },
  {
    "zh": "居善地，心善淵，與善仁，言善信，正善治，事善能，動善時。",
    "author": "老子",
    "work": "《道德經》",
    "source": "https://zh.wikisource.org/zh-hant/老子_(匯校版)",
    "excerpt": true
  },
  {
    "zh": "恩裏由來生害，故快意時，須早回頭；敗後或反成功，故拂心處，莫便放手。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "視其所以，觀其所由，察其所安，人焉廋哉！",
    "author": "孔子",
    "work": "《論語》",
    "source": "https://zh.wikisource.org/zh-hant/論語/全覽",
    "excerpt": true
  },
  {
    "zh": "持而盈之，不如其已。",
    "author": "老子",
    "work": "《道德經》",
    "source": "https://zh.wikisource.org/zh-hant/老子_(匯校版)",
    "excerpt": true
  },
  {
    "zh": "面前的田地要放得寬，使人無不平之歎；身後的惠澤要流得長，使人有不匱之思。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "君子周而不比，小人比而不周。",
    "author": "孔子",
    "work": "《論語》",
    "source": "https://zh.wikisource.org/zh-hant/論語/全覽",
    "excerpt": true
  },
  {
    "zh": "揣而銳之，不可長保。",
    "author": "老子",
    "work": "《道德經》",
    "source": "https://zh.wikisource.org/zh-hant/老子_(匯校版)",
    "excerpt": true
  },
  {
    "zh": "徑路窄處，留一步與人行；滋味濃的，減三分讓人嗜。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "人而無信，不知其可也。",
    "author": "孔子",
    "work": "《論語》",
    "source": "https://zh.wikisource.org/zh-hant/論語/全覽",
    "excerpt": true
  },
  {
    "zh": "金玉滿堂，莫之能守。",
    "author": "老子",
    "work": "《道德經》",
    "source": "https://zh.wikisource.org/zh-hant/老子_(匯校版)",
    "excerpt": true
  },
  {
    "zh": "作人無甚高遠事業，擺脫得俗情，便入名流；為學無甚增益工夫，減除得物累，便超聖境。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "射不主皮，為力不同科，古之道也。",
    "author": "孔子",
    "work": "《論語》",
    "source": "https://zh.wikisource.org/zh-hant/論語/全覽",
    "excerpt": true
  },
  {
    "zh": "富貴而驕，自遺其咎。",
    "author": "老子",
    "work": "《道德經》",
    "source": "https://zh.wikisource.org/zh-hant/老子_(匯校版)",
    "excerpt": true
  },
  {
    "zh": "交友須帶三分俠氣，做人要存一點素心。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "居上不寬，為禮不敬，臨喪不哀，吾何以觀之哉！",
    "author": "孔子",
    "work": "《論語》",
    "source": "https://zh.wikisource.org/zh-hant/論語/全覽",
    "excerpt": true
  },
  {
    "zh": "生之，畜之，生而不有，為而不恃，長而不宰。",
    "author": "老子",
    "work": "《道德經》",
    "source": "https://zh.wikisource.org/zh-hant/老子_(匯校版)",
    "excerpt": true
  },
  {
    "zh": "寵利毋居人前，德業毋落人後；受享毋踰分外，修為毋減分中。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "不仁者，不可以久處約，不可以長處樂。",
    "author": "孔子",
    "work": "《論語》",
    "source": "https://zh.wikisource.org/zh-hant/論語/全覽",
    "excerpt": true
  },
  {
    "zh": "三十輻共一轂，當其無，有車之用。",
    "author": "老子",
    "work": "《道德經》",
    "source": "https://zh.wikisource.org/zh-hant/老子_(匯校版)",
    "excerpt": true
  },
  {
    "zh": "處世讓一步為高，退步即進步的張本；待人寬一分是福，利人實利己的根基。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "惟仁者能好人，能惡人。",
    "author": "孔子",
    "work": "《論語》",
    "source": "https://zh.wikisource.org/zh-hant/論語/全覽",
    "excerpt": true
  },
  {
    "zh": "埏埴以為器，當其無，有器之用。",
    "author": "老子",
    "work": "《道德經》",
    "source": "https://zh.wikisource.org/zh-hant/老子_(匯校版)",
    "excerpt": true
  },
  {
    "zh": "蓋世功勞，當不得一個矜字；彌天罪過，當不得一個悔字。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "苟志於仁矣，無惡也。",
    "author": "孔子",
    "work": "《論語》",
    "source": "https://zh.wikisource.org/zh-hant/論語/全覽",
    "excerpt": true
  },
  {
    "zh": "鑿戶牖以為室，當其無，有室之用。",
    "author": "老子",
    "work": "《道德經》",
    "source": "https://zh.wikisource.org/zh-hant/老子_(匯校版)",
    "excerpt": true
  },
  {
    "zh": "完名美節，不宜獨任，分些與人，可以遠害全身；辱行污名，不宜全推，引些歸己，可以韜光養德。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "富與貴，是人之所欲也，不以其道得之，不處也。",
    "author": "孔子",
    "work": "《論語》",
    "source": "https://zh.wikisource.org/zh-hant/論語/全覽",
    "excerpt": true
  },
  {
    "zh": "故有之以為利，無之以為用。",
    "author": "老子",
    "work": "《道德經》",
    "source": "https://zh.wikisource.org/zh-hant/老子_(匯校版)",
    "excerpt": true
  },
  {
    "zh": "若業必求滿，功必求盈者，不生內變，必召外憂。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "士志於道，而恥惡衣惡食者，未足與議也！",
    "author": "孔子",
    "work": "《論語》",
    "source": "https://zh.wikisource.org/zh-hant/論語/全覽",
    "excerpt": true
  },
  {
    "zh": "執古之道，以御今之有。",
    "author": "老子",
    "work": "《道德經》",
    "source": "https://zh.wikisource.org/zh-hant/老子_(匯校版)",
    "excerpt": true
  },
  {
    "zh": "攻人之惡，毋太嚴，要思其堪受；教人之善，毋過高，當使其可從。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "君子之於天下也，無適也，無莫也，義之與比。",
    "author": "孔子",
    "work": "《論語》",
    "source": "https://zh.wikisource.org/zh-hant/論語/全覽",
    "excerpt": true
  },
  {
    "zh": "致虛，極；守靜，篤。",
    "author": "老子",
    "work": "《道德經》",
    "source": "https://zh.wikisource.org/zh-hant/老子_(匯校版)",
    "excerpt": true
  },
  {
    "zh": "居軒冕之中，不可無山林的氣味；處林泉之下，須要懷廊廟的經綸。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "君子懷德，小人懷土；君子懷刑，小人懷惠。",
    "author": "孔子",
    "work": "《論語》",
    "source": "https://zh.wikisource.org/zh-hant/論語/全覽",
    "excerpt": true
  },
  {
    "zh": "萬物並作，吾以觀復。",
    "author": "老子",
    "work": "《道德經》",
    "source": "https://zh.wikisource.org/zh-hant/老子_(匯校版)",
    "excerpt": true
  },
  {
    "zh": "處世不必邀功，無過便是功；與人不求感德，無怨便是德。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "不患無位，患所以立。",
    "author": "孔子",
    "work": "《論語》",
    "source": "https://zh.wikisource.org/zh-hant/論語/全覽",
    "excerpt": true
  },
  {
    "zh": "夫物芸芸，各復歸其根。",
    "author": "老子",
    "work": "《道德經》",
    "source": "https://zh.wikisource.org/zh-hant/老子_(匯校版)",
    "excerpt": true
  },
  {
    "zh": "憂勤是美德，太苦則無以適性怡情；澹泊是高風，太枯則無以濟人利物。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "君子喻於義，小人喻於利。",
    "author": "孔子",
    "work": "《論語》",
    "source": "https://zh.wikisource.org/zh-hant/論語/全覽",
    "excerpt": true
  },
  {
    "zh": "歸根曰靜，靜曰覆命。",
    "author": "老子",
    "work": "《道德經》",
    "source": "https://zh.wikisource.org/zh-hant/老子_(匯校版)",
    "excerpt": true
  },
  {
    "zh": "人至事窮勢蹙，宜原其初心；士當行滿功成，要觀其末路。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "見賢思齊焉，見不賢而內自省也。",
    "author": "孔子",
    "work": "《論語》",
    "source": "https://zh.wikisource.org/zh-hant/論語/全覽",
    "excerpt": true
  },
  {
    "zh": "覆命曰常，知常曰明。",
    "author": "老子",
    "work": "《道德經》",
    "source": "https://zh.wikisource.org/zh-hant/老子_(匯校版)",
    "excerpt": true
  },
  {
    "zh": "居卑而後知登高之為危，處晦而後知向明之太露；守靜而後知好動之過勞，養默而後知多言之為躁。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "古者言之不出，恥躬之不逮也。",
    "author": "孔子",
    "work": "《論語》",
    "source": "https://zh.wikisource.org/zh-hant/論語/全覽",
    "excerpt": true
  },
  {
    "zh": "知常容，容乃公，公乃王，王乃天，天乃道，道乃久，歿身不殆。",
    "author": "老子",
    "work": "《道德經》",
    "source": "https://zh.wikisource.org/zh-hant/老子_(匯校版)",
    "excerpt": true
  },
  {
    "zh": "待小人，不難於嚴，而難於不惡；待君子，不難於恭，而難於有禮。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "君子欲訥於言而敏於行。",
    "author": "孔子",
    "work": "《論語》",
    "source": "https://zh.wikisource.org/zh-hant/論語/全覽",
    "excerpt": true
  },
  {
    "zh": "信不足焉，有不信焉。",
    "author": "老子",
    "work": "《道德經》",
    "source": "https://zh.wikisource.org/zh-hant/老子_(匯校版)",
    "excerpt": true
  },
  {
    "zh": "寧守渾噩而黜聰明，留些正氣還天地；寧謝紛華而甘澹泊，遺個清名在乾坤。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "晏平仲善與人交，久而敬之。",
    "author": "孔子",
    "work": "《論語》",
    "source": "https://zh.wikisource.org/zh-hant/論語/全覽",
    "excerpt": true
  },
  {
    "zh": "故令有所屬：見素抱樸，少思寡慾，絕學無憂。",
    "author": "老子",
    "work": "《道德經》",
    "source": "https://zh.wikisource.org/zh-hant/老子_(匯校版)",
    "excerpt": true
  },
  {
    "zh": "降魔者，先降自心，心伏，則群魔退聽；馭橫者，先馭此氣，氣平，則外橫不侵。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "伯夷，叔齊，不念舊惡，怨是用希。",
    "author": "孔子",
    "work": "《論語》",
    "source": "https://zh.wikisource.org/zh-hant/論語/全覽",
    "excerpt": true
  },
  {
    "zh": "曲則全，枉則直，窪則盈，敝則新，少則得，多則惑。",
    "author": "老子",
    "work": "《道德經》",
    "source": "https://zh.wikisource.org/zh-hant/老子_(匯校版)",
    "excerpt": true
  },
  {
    "zh": "慾路上事，毋樂其便而姑為染指，一染指便深入萬仞；理路上事，無憚其難而稍為退步，一退步便遠隔千山。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "巧言，令色，足恭，左丘明恥之，丘亦恥之。",
    "author": "孔子",
    "work": "《論語》",
    "source": "https://zh.wikisource.org/zh-hant/論語/全覽",
    "excerpt": true
  },
  {
    "zh": "不自見，故明；不自是，故彰；不自伐，故有功；不自矜，故長。",
    "author": "老子",
    "work": "《道德經》",
    "source": "https://zh.wikisource.org/zh-hant/老子_(匯校版)",
    "excerpt": true
  },
  {
    "zh": "念頭濃者，自待厚，待人亦厚，處處皆濃；念頭淡者，自待薄，待人亦薄，處處皆淡。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "吾未見能見其過，而內自訟者也。",
    "author": "孔子",
    "work": "《論語》",
    "source": "https://zh.wikisource.org/zh-hant/論語/全覽",
    "excerpt": true
  },
  {
    "zh": "夫唯不爭，故天下莫能與之爭。",
    "author": "老子",
    "work": "《道德經》",
    "source": "https://zh.wikisource.org/zh-hant/老子_(匯校版)",
    "excerpt": true
  },
  {
    "zh": "風恬浪靜中，見人生之真境；味淡聲希處，識心體之本然。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "十室之邑，必有忠信如丘者焉，不如丘之好學也。",
    "author": "孔子",
    "work": "《論語》",
    "source": "https://zh.wikisource.org/zh-hant/論語/全覽",
    "excerpt": true
  },
  {
    "zh": "故飄風不終朝，驟雨不終日。",
    "author": "老子",
    "work": "《道德經》",
    "source": "https://zh.wikisource.org/zh-hant/老子_(匯校版)",
    "excerpt": true
  },
  {
    "zh": "立身不高一步立，如塵裏振衣，泥中濯足，如何超達；處世不退一步處，如飛蛾投燭，羝羊觸藩，如何安樂。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "質勝文則野，文勝質則史。",
    "author": "孔子",
    "work": "《論語》",
    "source": "https://zh.wikisource.org/zh-hant/論語/全覽",
    "excerpt": true
  },
  {
    "zh": "企者不立；跨者不行；自見者不明；自是者不彰；自伐者無功；自矜者不長。",
    "author": "老子",
    "work": "《道德經》",
    "source": "https://zh.wikisource.org/zh-hant/老子_(匯校版)",
    "excerpt": true
  },
  {
    "zh": "學者要收拾精神，併歸一路。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "人之生也直，罔之生也幸而免。",
    "author": "孔子",
    "work": "《論語》",
    "source": "https://zh.wikisource.org/zh-hant/論語/全覽",
    "excerpt": true
  },
  {
    "zh": "寂兮寥兮，獨立而不改，周行而不殆，可以為天地母。",
    "author": "老子",
    "work": "《道德經》",
    "source": "https://zh.wikisource.org/zh-hant/老子_(匯校版)",
    "excerpt": true
  },
  {
    "zh": "進德修道，要個木石的念頭，若一有欣羨，便趨慾境；濟世經邦，要段雲水的趣味，若一有貪著，便墮危機。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "知之者，不如好之者，好之者，不如樂之者。",
    "author": "孔子",
    "work": "《論語》",
    "source": "https://zh.wikisource.org/zh-hant/論語/全覽",
    "excerpt": true
  },
  {
    "zh": "故道大，天大，地大，人亦大。",
    "author": "老子",
    "work": "《道德經》",
    "source": "https://zh.wikisource.org/zh-hant/老子_(匯校版)",
    "excerpt": true
  },
  {
    "zh": "福莫福於少事，禍莫禍於多心。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "知者樂水，仁者樂山。",
    "author": "孔子",
    "work": "《論語》",
    "source": "https://zh.wikisource.org/zh-hant/論語/全覽",
    "excerpt": true
  },
  {
    "zh": "人法地，地法天，天法道，道法自然。",
    "author": "老子",
    "work": "《道德經》",
    "source": "https://zh.wikisource.org/zh-hant/老子_(匯校版)",
    "excerpt": true
  },
  {
    "zh": "處治世宜方，處亂世宜圓，處叔季之世，當方圓並用；待善人宜寬，待惡人宜嚴，待庸眾之人，當寬嚴互存。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "君子博學於文，約之以禮，亦可以弗畔矣夫！",
    "author": "孔子",
    "work": "《論語》",
    "source": "https://zh.wikisource.org/zh-hant/論語/全覽",
    "excerpt": true
  },
  {
    "zh": "重為輕根，靜為躁君。",
    "author": "老子",
    "work": "《道德經》",
    "source": "https://zh.wikisource.org/zh-hant/老子_(匯校版)",
    "excerpt": true
  },
  {
    "zh": "我有功於人不可念，而過則不可不念；人有恩於我不可忘，而怨則不可不忘。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "中庸之為德也，其至矣乎！",
    "author": "孔子",
    "work": "《論語》",
    "source": "https://zh.wikisource.org/zh-hant/論語/全覽",
    "excerpt": true
  },
  {
    "zh": "輕則失根，躁則失君。",
    "author": "老子",
    "work": "《道德經》",
    "source": "https://zh.wikisource.org/zh-hant/老子_(匯校版)",
    "excerpt": true
  },
  {
    "zh": "施恩者，內不見己，外不見人，則斗粟可當萬鍾之惠；利物者，計己之施，責人之報，雖百鎰難成一文之功。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "述而不作，信而好古，竊比於我老彭。",
    "author": "孔子",
    "work": "《論語》",
    "source": "https://zh.wikisource.org/zh-hant/論語/全覽",
    "excerpt": true
  },
  {
    "zh": "善行，無轍跡；善言，無瑕謫；善數，不用籌策；善閉，無關楗而不可開；善結，無繩約而不可解。",
    "author": "老子",
    "work": "《道德經》",
    "source": "https://zh.wikisource.org/zh-hant/老子_(匯校版)",
    "excerpt": true
  },
  {
    "zh": "心地清淨，方可讀書學古。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "默而識之，學而不厭，誨人不倦，何有於我哉？",
    "author": "孔子",
    "work": "《論語》",
    "source": "https://zh.wikisource.org/zh-hant/論語/全覽",
    "excerpt": true
  },
  {
    "zh": "是以聖人常善救人，故無棄人；常善救物，故無棄物。",
    "author": "老子",
    "work": "《道德經》",
    "source": "https://zh.wikisource.org/zh-hant/老子_(匯校版)",
    "excerpt": true
  },
  {
    "zh": "奢者富而不足，何如儉者貧而有餘；能者勞而府怨，何如拙者逸而全真。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "德之不脩，學之不講，聞義不能徙，不善不能改，是吾憂也。",
    "author": "孔子",
    "work": "《論語》",
    "source": "https://zh.wikisource.org/zh-hant/論語/全覽",
    "excerpt": true
  },
  {
    "zh": "故善人者，不善人之師；不善人者，善人之資。",
    "author": "老子",
    "work": "《道德經》",
    "source": "https://zh.wikisource.org/zh-hant/老子_(匯校版)",
    "excerpt": true
  },
  {
    "zh": "讀書不見聖賢，為鉛槧傭；居官不愛子民，為衣冠盜；講學不尚躬行，為口頭禪；立業不思種德，為眼前花。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "自行束脩以上，吾未嘗無誨焉。",
    "author": "孔子",
    "work": "《論語》",
    "source": "https://zh.wikisource.org/zh-hant/論語/全覽",
    "excerpt": true
  },
  {
    "zh": "知其雄，守其雌，為天下谿。",
    "author": "老子",
    "work": "《道德經》",
    "source": "https://zh.wikisource.org/zh-hant/老子_(匯校版)",
    "excerpt": true
  },
  {
    "zh": "苦心中，常得悅心之趣；得意時，須防失意之悲。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "不憤不啟；不悱不發。",
    "author": "孔子",
    "work": "《論語》",
    "source": "https://zh.wikisource.org/zh-hant/論語/全覽",
    "excerpt": true
  },
  {
    "zh": "知其白，守其黑，為天下式。",
    "author": "老子",
    "work": "《道德經》",
    "source": "https://zh.wikisource.org/zh-hant/老子_(匯校版)",
    "excerpt": true
  },
  {
    "zh": "春至時和，花尚舖一段好色，鳥且囀幾句好音。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "富而可求也，雖執鞭之士，吾亦為之；如不可求，從吾所好。",
    "author": "孔子",
    "work": "《論語》",
    "source": "https://zh.wikisource.org/zh-hant/論語/全覽",
    "excerpt": true
  },
  {
    "zh": "知其榮，守其辱，為天下谷。",
    "author": "老子",
    "work": "《道德經》",
    "source": "https://zh.wikisource.org/zh-hant/老子_(匯校版)",
    "excerpt": true
  },
  {
    "zh": "學者有段競業的心思，又要有段瀟灑的趣味。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "飯疏食，飮水，曲肱而枕之，樂亦在其中矣。",
    "author": "孔子",
    "work": "《論語》",
    "source": "https://zh.wikisource.org/zh-hant/論語/全覽",
    "excerpt": true
  },
  {
    "zh": "是以聖人無為，故無敗；無執，故無失。",
    "author": "老子",
    "work": "《道德經》",
    "source": "https://zh.wikisource.org/zh-hant/老子_(匯校版)",
    "excerpt": true
  },
  {
    "zh": "真廉無廉名，圖名者正所以為貪；大巧無巧術，用術者乃所以為拙。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "我非生而知之者，好古，敏以求之者也。",
    "author": "孔子",
    "work": "《論語》",
    "source": "https://zh.wikisource.org/zh-hant/論語/全覽",
    "excerpt": true
  },
  {
    "zh": "是以聖人去甚，去奢，去泰。",
    "author": "老子",
    "work": "《道德經》",
    "source": "https://zh.wikisource.org/zh-hant/老子_(匯校版)",
    "excerpt": true
  },
  {
    "zh": "人知名位為樂，不知無名無位之樂為最真；人知飢寒為憂，那知不飢不寒之憂為更甚。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "三人行，必有我師焉。",
    "author": "孔子",
    "work": "《論語》",
    "source": "https://zh.wikisource.org/zh-hant/論語/全覽",
    "excerpt": true
  },
  {
    "zh": "果而勿矜，果而勿伐，果而勿驕。",
    "author": "老子",
    "work": "《道德經》",
    "source": "https://zh.wikisource.org/zh-hant/老子_(匯校版)",
    "excerpt": true
  },
  {
    "zh": "為惡而畏人知，惡中猶有善路；為善而急人知，善處即是惡根。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "蓋有不知而作之者，我無是也。",
    "author": "孔子",
    "work": "《論語》",
    "source": "https://zh.wikisource.org/zh-hant/論語/全覽",
    "excerpt": true
  },
  {
    "zh": "果而不得已，果而勿強。",
    "author": "老子",
    "work": "《道德經》",
    "source": "https://zh.wikisource.org/zh-hant/老子_(匯校版)",
    "excerpt": true
  },
  {
    "zh": "十語九中，未必稱奇，一語不中，則愆尤駢集；十謀九成，未必歸功，一謀不成，則訾議叢興。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "文，莫吾猶人也；躬行君子，則吾未之有得！",
    "author": "孔子",
    "work": "《論語》",
    "source": "https://zh.wikisource.org/zh-hant/論語/全覽",
    "excerpt": true
  },
  {
    "zh": "始制有名，名亦既有，夫亦將知止，知止可以不殆。",
    "author": "老子",
    "work": "《道德經》",
    "source": "https://zh.wikisource.org/zh-hant/老子_(匯校版)",
    "excerpt": true
  },
  {
    "zh": "天理路上甚寬，稍游心，胸中便覺高明廣大；人慾路上甚窄，纔寄跡，眼前俱是荊棘泥塗。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "奢則不孫，儉則固；與其不孫也，甯固。",
    "author": "孔子",
    "work": "《論語》",
    "source": "https://zh.wikisource.org/zh-hant/論語/全覽",
    "excerpt": true
  },
  {
    "zh": "知人者智，自知者明。",
    "author": "老子",
    "work": "《道德經》",
    "source": "https://zh.wikisource.org/zh-hant/老子_(匯校版)",
    "excerpt": true
  },
  {
    "zh": "一苦一樂相磨鍊，鍊極而成福者，其福始久；一疑一信相參勘，勘極而成知者，其知始真。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "君子坦蕩蕩，小人長戚戚。",
    "author": "孔子",
    "work": "《論語》",
    "source": "https://zh.wikisource.org/zh-hant/論語/全覽",
    "excerpt": true
  },
  {
    "zh": "勝人者有力，自勝者強。",
    "author": "老子",
    "work": "《道德經》",
    "source": "https://zh.wikisource.org/zh-hant/老子_(匯校版)",
    "excerpt": true
  },
  {
    "zh": "心不可不虛，虛則義理來居；心不可不實，實則物慾不入。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "恭而無禮則勞，愼而無禮則葸，勇而無禮則亂，直而無禮則絞。",
    "author": "孔子",
    "work": "《論語》",
    "source": "https://zh.wikisource.org/zh-hant/論語/全覽",
    "excerpt": true
  },
  {
    "zh": "萬物恃之以生而不辭，功成而不有。",
    "author": "老子",
    "work": "《道德經》",
    "source": "https://zh.wikisource.org/zh-hant/老子_(匯校版)",
    "excerpt": true
  },
  {
    "zh": "人只一會貪私，便銷剛為柔，塞智為昏，變恩為慘，染潔為污，壞了一生人品。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "興於詩，立於禮，成於樂。",
    "author": "孔子",
    "work": "《論語》",
    "source": "https://zh.wikisource.org/zh-hant/論語/全覽",
    "excerpt": true
  },
  {
    "zh": "以其終不自為大，故能成其大。",
    "author": "老子",
    "work": "《道德經》",
    "source": "https://zh.wikisource.org/zh-hant/老子_(匯校版)",
    "excerpt": true
  },
  {
    "zh": "圖未就之功，不如保已成之業；悔既往之失，不如防將來之非。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "如有周公之才之美，使驕且吝，其餘不足觀也已！",
    "author": "孔子",
    "work": "《論語》",
    "source": "https://zh.wikisource.org/zh-hant/論語/全覽",
    "excerpt": true
  },
  {
    "zh": "是以大丈夫處其厚，不居其薄；處其實，不居其華。",
    "author": "老子",
    "work": "《道德經》",
    "source": "https://zh.wikisource.org/zh-hant/老子_(匯校版)",
    "excerpt": true
  },
  {
    "zh": "氣象要高曠，而不可疏狂；心思要縝密，而不可瑣屑；趣味要沖澹，而不可偏枯；操守要嚴明，而不可激烈。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "篤信好學，守死善道。",
    "author": "孔子",
    "work": "《論語》",
    "source": "https://zh.wikisource.org/zh-hant/論語/全覽",
    "excerpt": true
  },
  {
    "zh": "故貴以賤為本，高以下為基。",
    "author": "老子",
    "work": "《道德經》",
    "source": "https://zh.wikisource.org/zh-hant/老子_(匯校版)",
    "excerpt": true
  },
  {
    "zh": "風來疏竹，風過而竹不留聲；雁度寒潭，雁去而潭不留影。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "不在其位，不謀其政。",
    "author": "孔子",
    "work": "《論語》",
    "source": "https://zh.wikisource.org/zh-hant/論語/全覽",
    "excerpt": true
  },
  {
    "zh": "反者道之動；弱者道之用。",
    "author": "老子",
    "work": "《道德經》",
    "source": "https://zh.wikisource.org/zh-hant/老子_(匯校版)",
    "excerpt": true
  },
  {
    "zh": "清能有容，仁能善斷；明不傷察，直不過矯。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "學如不及，猶恐失之。",
    "author": "孔子",
    "work": "《論語》",
    "source": "https://zh.wikisource.org/zh-hant/論語/全覽",
    "excerpt": true
  },
  {
    "zh": "天下萬物生於有，有生於無。",
    "author": "老子",
    "work": "《道德經》",
    "source": "https://zh.wikisource.org/zh-hant/老子_(匯校版)",
    "excerpt": true
  },
  {
    "zh": "閒中不放過，忙處有受用；靜中不落空，動處有受用；暗中不欺隱，明處有受用。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "吾未見好德如好色者也。",
    "author": "孔子",
    "work": "《論語》",
    "source": "https://zh.wikisource.org/zh-hant/論語/全覽",
    "excerpt": true
  },
  {
    "zh": "上士聞道，勤而行之；中士聞道，若存若亡；下士聞道，大笑之。",
    "author": "老子",
    "work": "《道德經》",
    "source": "https://zh.wikisource.org/zh-hant/老子_(匯校版)",
    "excerpt": true
  },
  {
    "zh": "靜中念慮澄澈，見心之真體；閒中氣象從容，識心之真機；淡中意趣沖夷，得心之真味。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "譬如為山，未成一簣，止，吾止也！",
    "author": "孔子",
    "work": "《論語》",
    "source": "https://zh.wikisource.org/zh-hant/論語/全覽",
    "excerpt": true
  },
  {
    "zh": "道生一，一生二，二生三，三生萬物。",
    "author": "老子",
    "work": "《道德經》",
    "source": "https://zh.wikisource.org/zh-hant/老子_(匯校版)",
    "excerpt": true
  },
  {
    "zh": "靜中靜非真靜，動處靜得來，纔是性天之真境；樂纔樂非真樂，苦中樂得來，纔見心體之真機。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "後生可畏，焉知來者之不如今也？",
    "author": "孔子",
    "work": "《論語》",
    "source": "https://zh.wikisource.org/zh-hant/論語/全覽",
    "excerpt": true
  },
  {
    "zh": "萬物負陰而抱陽，沖氣以為和。",
    "author": "老子",
    "work": "《道德經》",
    "source": "https://zh.wikisource.org/zh-hant/老子_(匯校版)",
    "excerpt": true
  },
  {
    "zh": "天薄我以福，吾厚吾德以迓之；天勞我以形，吾逸吾心以補之；天阨我以遇，吾亨吾道以通之。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "主忠信，毋友不如己者，過則勿憚改。",
    "author": "孔子",
    "work": "《論語》",
    "source": "https://zh.wikisource.org/zh-hant/論語/全覽",
    "excerpt": true
  },
  {
    "zh": "故物或損之而益，或益之而損。",
    "author": "老子",
    "work": "《道德經》",
    "source": "https://zh.wikisource.org/zh-hant/老子_(匯校版)",
    "excerpt": true
  },
  {
    "zh": "平民肯種德施惠，便是無位的公相；士夫徒貪權市寵，竟成有爵的乞人。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "三軍可奪帥也，匹夫不可奪志也。",
    "author": "孔子",
    "work": "《論語》",
    "source": "https://zh.wikisource.org/zh-hant/論語/全覽",
    "excerpt": true
  },
  {
    "zh": "天下之至柔，馳騁天下之至堅。",
    "author": "老子",
    "work": "《道德經》",
    "source": "https://zh.wikisource.org/zh-hant/老子_(匯校版)",
    "excerpt": true
  },
  {
    "zh": "家人有過，不宜暴怒，不宜輕棄。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "歲寒，然後知松柏之後凋也。",
    "author": "孔子",
    "work": "《論語》",
    "source": "https://zh.wikisource.org/zh-hant/論語/全覽",
    "excerpt": true
  },
  {
    "zh": "不言之教，無為之益，天下希及之。",
    "author": "老子",
    "work": "《道德經》",
    "source": "https://zh.wikisource.org/zh-hant/老子_(匯校版)",
    "excerpt": true
  },
  {
    "zh": "此心常看得圓滿，天下自無缺憾之世界；此心常放得寬平，天下自無險側之人情。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "知者不惑，仁者不憂，勇者不懼。",
    "author": "孔子",
    "work": "《論語》",
    "source": "https://zh.wikisource.org/zh-hant/論語/全覽",
    "excerpt": true
  },
  {
    "zh": "甚愛必大費；多藏必厚亡。",
    "author": "老子",
    "work": "《道德經》",
    "source": "https://zh.wikisource.org/zh-hant/老子_(匯校版)",
    "excerpt": true
  },
  {
    "zh": "居逆境中，周身皆鍼砭藥石，砥節勵行而不覺；處順境內，滿前盡兵刃戈矛，銷膏糜骨而不知。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "可與共學，未可與適道；可與適道，未可與立；可與立，未可與權。",
    "author": "孔子",
    "work": "《論語》",
    "source": "https://zh.wikisource.org/zh-hant/論語/全覽",
    "excerpt": true
  },
  {
    "zh": "故知足不辱，知止不殆，可以長久。",
    "author": "老子",
    "work": "《道德經》",
    "source": "https://zh.wikisource.org/zh-hant/老子_(匯校版)",
    "excerpt": true
  },
  {
    "zh": "文章做到極處，無有他奇，只是恰好；人品做到極處，無有他異，只是本然。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "聽訟，吾猶人也；必也使無訟乎！",
    "author": "孔子",
    "work": "《論語》",
    "source": "https://zh.wikisource.org/zh-hant/論語/全覽",
    "excerpt": true
  },
  {
    "zh": "大成若缺，其用不弊。",
    "author": "老子",
    "work": "《道德經》",
    "source": "https://zh.wikisource.org/zh-hant/老子_(匯校版)",
    "excerpt": true
  },
  {
    "zh": "不責人小過，不發人陰私，不念人舊惡。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "博學以文，約之以禮；亦可以弗畔矣夫！",
    "author": "孔子",
    "work": "《論語》",
    "source": "https://zh.wikisource.org/zh-hant/論語/全覽",
    "excerpt": true
  },
  {
    "zh": "大盈若沖，其用不窮。",
    "author": "老子",
    "work": "《道德經》",
    "source": "https://zh.wikisource.org/zh-hant/老子_(匯校版)",
    "excerpt": true
  },
  {
    "zh": "士君子持身不可輕，輕則物能撓我，而無悠閑鎮定之趣；用意不可重，重則我為物泥，而無瀟灑活潑之機。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "君子成人之美，不成人之惡。",
    "author": "孔子",
    "work": "《論語》",
    "source": "https://zh.wikisource.org/zh-hant/論語/全覽",
    "excerpt": true
  },
  {
    "zh": "大直若屈，大巧若拙，大辯若訥。",
    "author": "老子",
    "work": "《道德經》",
    "source": "https://zh.wikisource.org/zh-hant/老子_(匯校版)",
    "excerpt": true
  },
  {
    "zh": "天地有萬古，此身不再得；人生只百年，此日最易過。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "其身正，不令而行；其身不正，雖令不從。",
    "author": "孔子",
    "work": "《論語》",
    "source": "https://zh.wikisource.org/zh-hant/論語/全覽",
    "excerpt": true
  },
  {
    "zh": "禍莫大於不知足；咎莫大於欲得。",
    "author": "老子",
    "work": "《道德經》",
    "source": "https://zh.wikisource.org/zh-hant/老子_(匯校版)",
    "excerpt": true
  },
  {
    "zh": "市私恩，不如扶公議；結新知，不如敦舊好；立榮名，不如種隱德；尚奇節，不如謹庸行。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "苟正其身矣，於從政乎何有？",
    "author": "孔子",
    "work": "《論語》",
    "source": "https://zh.wikisource.org/zh-hant/論語/全覽",
    "excerpt": true
  },
  {
    "zh": "故知足之足，常足矣。",
    "author": "老子",
    "work": "《道德經》",
    "source": "https://zh.wikisource.org/zh-hant/老子_(匯校版)",
    "excerpt": true
  },
  {
    "zh": "曲意而使人喜，不若直躬而使人忌；無善而致人譽，不若無惡而致人毀。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "不得中行而與之，必也狂狷乎：狂者進取，狷者有所不為也。",
    "author": "孔子",
    "work": "《論語》",
    "source": "https://zh.wikisource.org/zh-hant/論語/全覽",
    "excerpt": true
  },
  {
    "zh": "為學日益，為道日損。",
    "author": "老子",
    "work": "《道德經》",
    "source": "https://zh.wikisource.org/zh-hant/老子_(匯校版)",
    "excerpt": true
  },
  {
    "zh": "處父兄骨肉之變，宜從容，不宜激烈；遇朋友交遊之失，宜剴切，不宜優游。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "君子和而不同，小人同而不和。",
    "author": "孔子",
    "work": "《論語》",
    "source": "https://zh.wikisource.org/zh-hant/論語/全覽",
    "excerpt": true
  },
  {
    "zh": "損之又損，以至於無為。",
    "author": "老子",
    "work": "《道德經》",
    "source": "https://zh.wikisource.org/zh-hant/老子_(匯校版)",
    "excerpt": true
  },
  {
    "zh": "小處不滲漏，暗處不欺隱，末路不怠荒，纔是個真正英雄。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "君子易事而難說也；說之不以道，不說也；及其使人也，器之。",
    "author": "孔子",
    "work": "《論語》",
    "source": "https://zh.wikisource.org/zh-hant/論語/全覽",
    "excerpt": true
  },
  {
    "zh": "聖人常無心，以百姓心為心。",
    "author": "老子",
    "work": "《道德經》",
    "source": "https://zh.wikisource.org/zh-hant/老子_(匯校版)",
    "excerpt": true
  },
  {
    "zh": "千金難結一時之歡，一飯竟致終身之感。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "君子泰而不驕；小人驕而不泰。",
    "author": "孔子",
    "work": "《論語》",
    "source": "https://zh.wikisource.org/zh-hant/論語/全覽",
    "excerpt": true
  },
  {
    "zh": "衰颯的景象，就在盛滿中；發生的機緘，即在零落內。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "士而懷居，不足以為士矣！",
    "author": "孔子",
    "work": "《論語》",
    "source": "https://zh.wikisource.org/zh-hant/論語/全覽",
    "excerpt": true
  },
  {
    "zh": "毋以己之長而形人之短，毋因己之拙而忌人之能。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "邦有道，危言危行；邦無道，危行言孫。",
    "author": "孔子",
    "work": "《論語》",
    "source": "https://zh.wikisource.org/zh-hant/論語/全覽",
    "excerpt": true
  },
  {
    "zh": "念頭昏散處，要知提醒；念頭喫緊時，要知放下。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "有德者必有言，有言者不必有德。",
    "author": "孔子",
    "work": "《論語》",
    "source": "https://zh.wikisource.org/zh-hant/論語/全覽",
    "excerpt": true
  },
  {
    "zh": "霽日青天，倏變為迅雷震電；疾風怒雨，倏轉為朗月晴空。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "貧而無怨，難；富而無驕，易。",
    "author": "孔子",
    "work": "《論語》",
    "source": "https://zh.wikisource.org/zh-hant/論語/全覽",
    "excerpt": true
  },
  {
    "zh": "覺人之詐，不形於言；受人之侮，不動於色。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "其言之不怍，則為之也難！",
    "author": "孔子",
    "work": "《論語》",
    "source": "https://zh.wikisource.org/zh-hant/論語/全覽",
    "excerpt": true
  },
  {
    "zh": "毋因群疑而阻獨見，毋任己意而廢人言，毋私小惠而傷大體，毋借公論以快私情。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "君子上達，小人下達。",
    "author": "孔子",
    "work": "《論語》",
    "source": "https://zh.wikisource.org/zh-hant/論語/全覽",
    "excerpt": true
  },
  {
    "zh": "青天白日的節義，自暗室屋漏中培來；旋乾轉坤的經綸，自臨深履薄處繅出。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "古之學者為己，今之學者為人。",
    "author": "孔子",
    "work": "《論語》",
    "source": "https://zh.wikisource.org/zh-hant/論語/全覽",
    "excerpt": true
  },
  {
    "zh": "德者才之主，才者德之奴。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "士君子，貧不能濟物者，遇人癡迷處，出一言提醒之；遇人急難處，出一言解救之，亦是無量功德。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "德隨量進，量由識長。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "反己者，觸事皆成藥石；尤人者，動念即是戈矛。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "事業文章隨身銷毀，而精神萬古如新；功名富貴逐世轉移，而氣節千載一日。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "作人無點真懇念頭，便成個花子，事事皆虛；涉世無段圓活機趣，便是個木人，處處有礙。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "水不波則自定，鑑不翳則自明，故心無可清，去其混之者，而清自現；樂不必尋，去其苦之者，而樂自存。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "事有急之不白者，寬之或自明，毋躁急以速其忿；人有操之不從者，縱之或自化，毋操切以益其頑。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "謝事當謝於正盛之時，居身宜居於獨後之地。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "交市人，不如友山翁；謁朱門，不如親白屋；聽街談巷語，不如聞牧唱樵歌；談今人失德過差，不如述古人嘉言懿行。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "德者事業之基，未有基不固而棟宇堅久者。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "信人者，人未必盡誠，己則獨誠矣；疑人者，人未必皆詐，己則先詐矣。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "念頭寬厚的，如春風煦育，萬物遭之而生；念頭忌刻的，如朔雪陰凝，萬物遭之而死。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "為善不見其益，如草裏東瓜，自應暗長；為惡不見其損，如庭前春雪，勢必潛消。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "遇故舊之交，意氣要愈新；處隱微之地，心跡宜愈顯；待衰朽的輩，恩禮當愈隆。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "勤者敏於德義，而世人借勤以濟其貧；儉者淡於貨利，而世人假儉以飾其吝。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "憑意興作為者，隨作則隨止，豈是不退之車輪；從情識解悟者，有悟則有迷，終非常明之燈燭。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "人之過誤宜恕，而在己則不可恕；己之困辱宜忍，而在人則不可忍。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "能脫俗便是奇，作意尚奇者，不為奇而為異；不合污便是清，矯情求清者，不為清而為激。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "心虛則性現，不息心而求見性，如撥波覓月；意淨則心清，不了意而求明心，如索鏡增塵。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "無事時，心易昏昧，宜寂寂而照以惺惺；有事時，心易奔逸，宜惺惺以而主以寂寂。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "議事者，身在事外，宜悉利害之情；任事者，身居事中，當絕利害之慮。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "一念慈祥，可以醞釀兩間和氣；寸心潔白，可以昭垂百代清芬。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "忙裏要偷閑，須先向閑時討個把柄；鬧中要取靜，須先從靜裏立個根基；不然，未有不因境而遷，隨時而靡者。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "不昧己心，不盡人情，不竭物力；三者可以為天地立心，為生民立命，為子孫造福。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "處富貴之地，要知貧賤的痛癢；當少壯之時，須念衰老的辛酸。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "磨礪當如百煉之金，急就者，必非邃養；施為宜似千鈞之弩，輕發者，決無宏功。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "山之高峻處無木，而谿谷迴環則草木叢生；水之湍急處無魚，而淵潭停蓄則魚鼈聚集。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "建功立業者，多圓融之士；僨事失機者，必執拗之人。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "處世不必與俗同，亦不宜與俗異；作事不必令人喜，亦不可令人憎。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "日既暮而猶煙霞絢爛，歲將晚而更橙橘芳馨。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "儉，美德也，過儉則為慳吝，為鄙嗇，反傷雅道；讓，懿行也，過讓則為足恭，為曲謹，多出機心。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "毋憂拂意，毋喜快心，毋恃久安，毋憚初難。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "世人以心愜處為樂，卻被樂心引入苦處；達士以心拂處為樂，終由苦心換得樂來。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "居盈滿者，如水之將溢未溢，切忌再加一滴；處危急者，如木之將折未折，切忌再加一搦。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "仁人心地寬舒，便福厚而慶長，事事成個寬舒氣象；鄙夫念頭迫促，便福薄而澤短，事事得個迫促規模。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "性躁心粗者，一事無成；心和氣平者，百福自集。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "用人不宜刻，刻則思效者去；交友不宜濫，濫則貢諛者來。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "風斜雨急處，要立得腳定；花濃柳豔處，要著得眼高；路危徑險處，要回得頭早。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "節義之人濟以和衷，纔不啟忿爭之路；功名之士承以謙德，方不開嫉妒之門。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "事稍拂逆，便思不如我的人，則尤怨自消；心稍怠荒，便思勝似我的人，則精神自奮。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "不可乘喜而輕諾，不可因醉而生嗔，不可乘快而多事，不可因倦而鮮終。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "善讀書者，要讀到手舞足蹈處，方不落筌蹄；善觀物者，要觀到心融神洽時，方不泥跡象。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "口乃心之門，守口不密，洩盡真機；意乃心之足，防意不嚴，走盡邪蹊。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "責人者，原無過於有過之中，則情平；責己者，求有過於無過之內，則德進。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "桃李雖豔，何如松蒼柏翠之堅貞；梨杏雖甘，何如橘綠橙黃之馨冽。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "爭先的徑路窄，退後一歩自寬平一歩。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "忙處不亂性，須閒處心神養得清。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "孤雲出岫，去留一無所係。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "悠長之趣，不得於醲釅，而得於啜菽飲水。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "水流而境無聲，得處喧見寂之趣。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "出世之道，即在渉世中，不必絶人以逃世。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "徜徉於山林泉石之閒，而塵心漸息。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "花居盆內，終乏生機，鳥入籠中，便減天趣。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "簾櫳高敞，看青山綠水呑吐雲煙，識乾坤之自在。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "林間松韻，石上泉聲，靜裡聴來，識天地自然鳴佩。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "心地上無風濤，隨在皆青山綠樹。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "寵辱不驚，閑看庭前花開花落。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "伏久者，飛必高，開先者，謝獨早。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  },
  {
    "zh": "意所偶會，便成佳境，物出天然，纔見真機。",
    "author": "洪應明",
    "work": "《菜根譚》",
    "source": "https://zh.wikisource.org/zh-hant/菜根譚",
    "excerpt": true
  }
]
